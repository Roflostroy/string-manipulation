#!/bin/bash

read -r -p "Строка: " t

echo "1) Поиск"                                               # ==============================================================================
echo "2) Срез"                                                # ПЕРЕМЕННЫЕ СКРИПТА:
echo "3) Замена"                                              # $t — исходный текст      $c — выбор главного меню      $s — искомое слово
echo "4) Удаление"                                            # $apos — текст до слова   $bpos — длина текста $apos    $cpos — длина слова $s
echo "5) Добавление"                                          # $a — стартовая позиция   $b — количество символов      $r — новый текст
read -r -p "Выбор: " c                                        # $d — вариант удаления (1-середина, 2-начало, 3-конец)
                                                              # ==============================================================================
if [[ "$c" == "1" ]];
then
    read -r -p "Подстрока: " s
    if [[ "$t" == *"$s"* ]];
    then
        echo "Подстрока существует"
        apos="${t%%"$s"*}"
        echo "Позиция начала (с 0): ${#apos}"
    else
        echo "Не найдено"
    fi

elif [[ "$c" == "2" ]];
then
    read -r -p "Старт: " a
    read -r -p "Длина: " b
    echo "${t:$a:$b}"

elif [[ "$c" == "3" ]];
then
    read -r -p "Что: " s
    read -r -p "На что: " r
    echo "${t//"$s"/"$r"}"

elif [[ "$c" == "4" ]];
then
    echo "1. Из середины"
    echo "2. С начала"
    echo "3. С конца"
    read -r -p "Выбор: " d

    if [[ "$d" == "1" ]];
    then
        read -r -p "Старт: " a
        read -r -p "Длина: " b
        echo "${t:0:$a}${t:$((a + b))}"
    elif [[ "$d" == "2" ]];
    then
        read -r -p "Кол-во: " b
        echo "${t:$b}"
    elif [[ "$d" == "3" ]];
    then
        read -r -p "Кол-во: " b
        echo "${t:0:${#t}-b}"
    fi

elif [[ "$c" == "5" ]];
then
    echo "1. В начало"
    echo "2. В конец"
    echo "3. В определенную позицию"
    read -r -p "Выбор: " d

    if [[ "$d" == "1" ]];
    then
        read -r -p "Что добавить: " s
        echo "${s}${t}"
    elif [[ "$d" == "2" ]];
    then
        read -r -p "Что добавить: " s
        echo "${t}${s}"
    elif [[ "$d" == "3" ]];
    then
        read -r -p "Позиция (индекс с 0): " a
        read -r -p "Что добавить: " s
        echo "${t:0:$a}${s}${t:$a}"
    fi
fi
